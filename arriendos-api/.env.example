# ============================================================
# ARRIENDOS CARTAGENA API · Configuración (copia este archivo a ".env")
# ============================================================

# Puerto del servidor
PORT=3002

# Conexión a PostgreSQL (ver ./db/docker-compose.yml)
DATABASE_URL=postgres://arriendos:arriendos@localhost:5433/arriendos

# Secreto para firmar los JWT (cámbialo en producción)
JWT_SECRET=cambia-este-secreto-en-produccion

# Cada cuántos minutos se sincroniza automáticamente el calendario
# de Booking/Airbnb de cada apartamento (0 = desactiva la sincronización automática)
SYNC_INTERVAL_MIN=30

# URL pública donde queda corriendo esta API (para armar el link
# .ics que se pega en Booking/Airbnb como "importar calendario").
# En local puedes dejar la de abajo.
PUBLIC_URL=http://localhost:3002

# (Opcional) Clave de la API de Claude/Anthropic para el asistente de
# preguntas (botón 💬 dentro de la app). Sin esta clave la app funciona
# igual, solo que el botón del asistente responde con un aviso.
# Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
