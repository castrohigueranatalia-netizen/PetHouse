# ============================================================
# PETHOUSE API · Configuración (copia este archivo a ".env")
# ============================================================

# Puerto del servidor
PORT=3001

# Conexión a PostgreSQL + PostGIS (ver ../db/docker-compose.yml)
DATABASE_URL=postgres://pethouse:pethouse@localhost:5432/pethouse

# Secreto para firmar los JWT (cámbialo en producción)
JWT_SECRET=cambia-este-secreto-en-produccion

# (Opcional) Clave de Gemini para el asistente de IA
# https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
