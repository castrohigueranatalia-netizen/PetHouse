# ============================================================
# PETHOUSE API · Configuración (copia este archivo a ".env")
# ============================================================

# Puerto del servidor
PORT=3001

# Conexión a PostgreSQL + PostGIS (ver ../db/docker-compose.yml)
DATABASE_URL=postgres://pethouse:pethouse@localhost:5432/pethouse

# Secreto para firmar los JWT. OBLIGATORIO cuando NODE_ENV=production (el servidor no
# arranca sin él). En desarrollo, si se omite, se genera uno aleatorio en cada arranque
# (ver src/config.js) — cómodo para probar, pero invalida sesiones al reiniciar.
JWT_SECRET=

# En producción: pon NODE_ENV=production (activa el chequeo obligatorio de JWT_SECRET
# de arriba). Déjalo vacío/"development" en desarrollo local.
NODE_ENV=

# Orígenes permitidos para CORS, separados por coma (ej. la URL de la PWA en GitHub Pages).
# Sin configurar, CORS queda abierto — solo aceptable en desarrollo local.
ALLOWED_ORIGINS=

# URL pública de esta API, usada para construir los links de POST /api/subidas
# (ej. https://api.pethouse.co). Por defecto: http://localhost:<PORT>.
PUBLIC_BASE_URL=

# (Opcional) Clave de Gemini para el asistente de IA
# https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# (Opcional) Notificaciones push (APNs — Apple Push Notification service). Requiere una
# cuenta de pago de Apple Developer Program ($99/año) y tener la capacidad "Push
# Notifications" habilitada en Xcode para la app (ver PetHouseiOS/README.md). Mientras
# estas 4 variables no estén TODAS configuradas, el envío de push queda desactivado sin
# romper nada más (la campana de notificaciones dentro de la app sigue funcionando igual).
#
# Cómo conseguirlas, una vez tengas la cuenta paga:
# 1. developer.apple.com → Certificates, IDs & Profiles → Keys → "+" → marca "Apple Push
#    Notifications service (APNs)" → Continue → Register → Download (el archivo
#    AuthKey_XXXXXXXXXX.p8 solo se puede descargar UNA vez, guárdalo bien).
# 2. APNS_KEY_PATH: ruta en el servidor donde subas ese archivo .p8 (ej. /etc/pethouse/AuthKey_XXXXXXXXXX.p8).
# 3. APNS_KEY_ID: los 10 caracteres "XXXXXXXXXX" del nombre del archivo/la clave creada.
# 4. APNS_TEAM_ID: developer.apple.com → Membership → "Team ID".
# 5. APNS_BUNDLE_ID: el identificador de la app (ver PetHouseiOS/project.yml → PRODUCT_BUNDLE_IDENTIFIER).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# "production" cuando la app ya esté publicada en la App Store/TestFlight, o vacío/
# "sandbox" mientras se prueba corriendo desde Xcode (por defecto: sandbox).
APNS_ENVIRONMENT=
